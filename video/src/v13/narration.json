  "lines": [
    {
      "key": "hook",
      "text": "Three thousand dollars buys you one designer bag. Or thirty replicas.",
      "start": 0.35,
      "end": 4.449
    },
    {
      "key": "math",
      "text": "At about a hundred dollars each, that's a new style every month, for two and a half years.",
      "start": 5.049,
      "end": 9.541
    },
    {
      "key": "match",
      "text": "One bag matches some of your outfits. Thirty match all of them.",
      "start": 10.141,
      "end": 13.439
    },
    {
      "key": "plans",
      "text": "Work, the gym, date night, a weekend away. There's a bag for every plan.",
      "start": 13.989,
      "end": 18.069
    },
    {
      "key": "scuff",
      "text": "And if one gets scuffed or lost, you've still got twenty-nine.",
      "start": 18.669,
      "end": 21.736
    },
    {
      "key": "end",
      "text": "One logo, or thirty looks? Which would you pick?",
      "start": 22.336,
      "end": 24.865
    }
  ],
