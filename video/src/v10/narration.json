  "duration": 48.638,
  "lines": [
    {
      "key": "hook",
      "text": "This bag costs three thousand dollars. Let's follow where that money actually goes.",
      "start": 0.35,
      "end": 4.9
    },
    {
      "key": "factory",
      "text": "It starts in a factory. Leather, hardware and labour come to roughly three hundred dollars.",
      "start": 5.5,
      "end": 10.43
    },
    {
      "key": "logo",
      "text": "Then the brand stamps on its logo, and the price jumps to twelve hundred.",
      "start": 11.03,
      "end": 14.747
    },
    {
      "key": "ads",
      "text": "Next come the ads. Celebrities, billboards, magazine covers. Add another six hundred.",
      "start": 15.347,
      "end": 20.218
    },
    {
      "key": "store",
      "text": "Then the store. Prime rent, marble floors, a guy at the door. Another twelve hundred.",
      "start": 20.818,
      "end": 25.551
    },
    {
      "key": "you",
      "text": "By the time it reaches you, it's three thousand dollars, and you paid for every billboard.",
      "start": 26.151,
      "end": 30.755
    },
    {
      "key": "replica",
      "text": "Now the replica. Similar design, cheaper materials, no logo tax, no billboards, no marble floors. It ships straight to you, for about a hundred dollars.",
      "start": 31.355,
      "end": 40.738
    },
    {
      "key": "end",
      "text": "Same look on your arm. The difference is everything you never see. So, which one are you paying for?",
      "start": 41.338,
      "end": 46.638
    }
  ],
