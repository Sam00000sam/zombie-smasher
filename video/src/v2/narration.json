  "lines": [
    {
      "key": "hook",
      "text": "Why pay hundreds for a brand name, when a cheaper alternative might do the same job?",
      "start": 0.5,
      "end": 5.122
    },
    {
      "key": "compare",
      "text": "Sometimes, you're paying more for the logo, the marketing, and the prestige. Not necessarily better performance.",
      "start": 5.672,
      "end": 11.999
    },
    {
      "key": "value",
      "text": "Affordable alternatives can offer impressive quality and functionality, without the premium price tag.",
      "start": 12.549,
      "end": 18.111
    },
    {
      "key": "reality1",
      "text": "Of course, counterfeits aren't always better.",
      "start": 18.661,
      "end": 20.844
    },
    {
      "key": "reality2",
      "text": "Genuine products can offer safer materials, warranties, and better quality control.",
      "start": 21.194,
      "end": 25.961
    },
    {
      "key": "end1",
      "text": "Think about what you're actually paying for.",
      "start": 26.511,
      "end": 28.341
    },
    {
      "key": "end2",
      "text": "Buy smart. Not expensive.",
      "start": 28.791,
      "end": 30.416
    }
  ],
