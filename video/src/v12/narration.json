  "lines": [
    {
      "key": "hook",
      "text": "One of these bags is fake. Can you spot it?",
      "start": 0.35,
      "end": 2.581
    },
    {
      "key": "stitch",
      "text": "Check the stitching. Even, tight, no loose threads on either one.",
      "start": 3.181,
      "end": 6.76
    },
    {
      "key": "hardware",
      "text": "Look at the hardware. Same gold finish, same weight in your hand.",
      "start": 7.31,
      "end": 10.765
    },
    {
      "key": "shape",
      "text": "And the shape holds up exactly the same.",
      "start": 11.315,
      "end": 13.343
    },
    {
      "key": "give",
      "text": "Give up? Here's the only real difference.",
      "start": 13.943,
      "end": 15.928
    },
    {
      "key": "reveal",
      "text": "This one costs three thousand dollars. This one, about a hundred. Same bag on your arm.",
      "start": 16.477,
      "end": 21.361
    },
    {
      "key": "end",
      "text": "So which one did you pick? Tell me in the comments.",
      "start": 21.961,
      "end": 24.271
    }
  ],
