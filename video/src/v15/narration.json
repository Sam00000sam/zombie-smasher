    {
      "key": "order",
      "text": "Order in the court.",
      "start": 0.35,
      "end": 1.304
    },
    {
      "key": "case",
      "text": "Today's case: real versus replica.",
      "start": 1.704,
      "end": 3.97
    },
    {
      "key": "a1",
      "text": "Exhibit A: the sneakers.",
      "start": 4.67,
      "end": 6.261
    },
    {
      "key": "a2",
      "text": "The real pair costs nine hundred dollars.",
      "start": 6.661,
      "end": 8.892
    },
    {
      "key": "a3",
      "text": "The replica costs eighty.",
      "start": 9.242,
      "end": 10.606
    },
    {
      "key": "b1",
      "text": "Exhibit B: the watch.",
      "start": 11.306,
      "end": 12.776
    },
    {
      "key": "b2",
      "text": "It tells the exact same time.",
      "start": 13.176,
      "end": 14.755
    },
    {
      "key": "b3",
      "text": "One costs five thousand dollars. The other is about two hundred.",
      "start": 15.105,
      "end": 18.661
    },
    {
      "key": "c1",
      "text": "Exhibit C: the sunglasses.",
      "start": 19.361,
      "end": 21.218
    },
    {
      "key": "c2",
      "text": "They block the same sun, for a fraction of the price.",
      "start": 21.618,
      "end": 24.339
    },
    {
      "key": "jury",
      "text": "The jury has seen enough.",
      "start": 25.039,
      "end": 26.267
    },
    {
      "key": "v1",
      "text": "The verdict?",
      "start": 26.867,
      "end": 27.602
    },
    {
      "key": "v2",
      "text": "The replica looks the part, and your wallet wins.",
      "start": 28.052,
      "end": 30.541
    },
    {
      "key": "end",
      "text": "Do you agree with the verdict? Tell me in the comments.",
      "start": 31.241,
      "end": 33.687
    }
